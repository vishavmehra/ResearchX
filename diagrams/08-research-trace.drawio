" x="0.0" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=1.4;strokeColor=#5b616d;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="apis" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fields" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;EVERY EVENT&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;What a trace row holds&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;step · status (completed, failed, skipped, not_required) · latency_ms · budget_ms and over_budget · detail: model, routing decision, counts, reasons, errors&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#eef1f6;strokeColor=#9aa6b8;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="56" y="320" width="576" height="120" as="geometry"/></mxCell><mxCell id="t9" value="A step name missing from the CHECK list is rejected by the database and the run reports trace_persisted: false." style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=12.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="712" y="400" width="600" height="44" as="geometry"/></mxCell><mxCell id="z10" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;fillColor=#efede6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="472" width="1296" height="248" as="geometry"/></mxCell><mxCell id="t11" value="&lt;span style=&quot;letter-spacing:0.08em&quot;&gt;THE 34 STEP NAMES&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="46" y="482" width="1268" height="17" as="geometry"/></mxCell><mxCell id="g0" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Run setup · 5&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;query_understanding, laya_decision, research_strategy, model_routing, cache_lookup&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="56" y="512" width="236" height="192" as="geometry"/></mxCell><mxCell id="g1" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Retrieval · 4&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;bm25, pgvector, hybrid_fusion, reranking&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="308" y="512" width="236" height="192" as="geometry"/></mxCell><mxCell id="g2" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Evidence · 10&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;evidence_assessment, evidence_gap, external_sources, tavily, source_validation, external_extraction, evidence_extraction, experiment_extraction, contradiction_detection, evidence_selection&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="560" y="512" width="236" height="192" as="geometry"/></mxCell><mxCell id="g3" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Answer · 6&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;synthesis, citation_validation, abstention, fallback, answer, graph_enrichment&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="812" y="512" width="236" height="192" as="geometry"/></mxCell><mxCell id="g4" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Analyses · 9&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;analysis_request, experiment_retrieval, field_facts, comparison, comparability, runtime_enrichment, assessment, recommendations, coverage&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="1064" y="512" width="236" height="192" as="geometry"/></mxCell><mxCell id="l12" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#cfcabd;" vertex="1" parent="1"><mxGeometry x="40" y="737" width="22" height="16" as="geometry"/></mxCell><mxCell id="t13" value="Component" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="737" width="70.1" height="18" as="geometry"/></mxCell><mxCell id="l14" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#e2f0ee;strokeColor=#0e6b66;" vertex="1" parent="1"><mxGeometry x="158.1" y="737" width="22" height="16" as="geometry"/></mxCell><mxCell id="t15" value="Tracer" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="188.1" y="737" width="49