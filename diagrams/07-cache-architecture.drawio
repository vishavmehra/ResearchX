<mxfile host="ResearchX diagrams/src/build.py" type="device"><diagram id="07-cache-architecture" name="Cache architecture"><mxGraphModel dx="1360" dy="1064" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1064" background="#f6f5f1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#f6f5f1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1360" height="1064" as="geometry"/></mxCell><mxCell id="t1" value="Cache architecture" style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=26;fontColor=#16181d;align=left;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1280" height="36" as="geometry"/></mxCell><mxCell id="t2" value="Four separate caches, all scoped to one user. A hit skips real work; a miss computes and stores." style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=14;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1280" height="22" as="geometry"/></mxCell><mxCell id="q" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;SIGNED-IN USER&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Question&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Every cache key includes the user id&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="96" y="128" width="360" height="80" as="geometry"/></mxCell><mxCell id="d1" value="Answer cached for this user?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12.5;fontColor=#16181d;fontStyle=1;fillColor=#ffffff;strokeColor=#16181d;strokeWidth=1.25;spacing=14;" vertex="1" parent="1"><mxGeometry x="156" y="232" width="240" height="96" as="geometry"/></mxCell><mxCell id="emb" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Query embedding&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Cache first; on a miss Nebius embeds the question&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="96" y="384" width="360" height="88" as="geometry"/></mxCell><mxCell id="rr" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Rerank&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Cache first for the exact candidate set; on a miss Nemotron grades it&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="96" y="520" width="360" height="88" as="geometry"/></mxCell><mxCell id="ext" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;External search (on an evidence gap)&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Each provider&#x27;s cached results first; on a miss it is called&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="96" y="656" width="360" height="88" as="geometry"/></mxCell><mxCell id="syn" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Synthesis, validation, outcome&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Never cached: computed from the selected evidence&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="96" y="792" width="360" height="88" as="geometry"/></mxCell><mxCell id="out" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Answer shown&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;cached: true on a hit (no model or provider calls)&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#e4f3ea;strokeColor=#1e7a46;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="96" y="928" width="360" height="72" as="geometry"/></mxCell><mxCell id="c_ans" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;POSTGRES · rx.cache_entries KIND &#x27;model&#x27; · DURABLE&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Answer cache&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Per user (user_id + RLS) · 168 h · key: pipeline version, release, user, normalised question. Written only for ANSWERED, PARTIAL or CONFLICTING while the database is under 450 MB; emptied for the user when they upload or delete a document. A hit returns the stored answer without model calls.&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=2;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;" vertex="1" parent="1"><mxGeometry x="616" y="208" width="680" height="144" as="geometry"/></mxCell><mxCell id="c_emb" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;IN PROCESS · services/runtime/memo.py&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Query-embedding cache&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Per user · 6 h · 1,024 entries, least recently used evicted · key: model, embedding version, user, question · emptied by a restart&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="616" y="372" width="680" height="112" as="geometry"/></mxCell><mxCell id="c_rr" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;IN PROCESS · services/runtime/memo.py&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Reranker-grade cache&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Per user · 6 h · 512 entries · key: model, prompt version, user, question, each candidate&#x27;s id and text hash · emptied by a restart&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="616" y="508" width="680" height="112" as="geometry"/></mxCell><mxCell id="c_ext" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;POSTGRES · rx.cache_entries KIND &#x27;api&#x27; · DURABLE&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;External-provider cache&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Per user, never shared · 24 h · key: user, provider, query, limit · written while the database is under 450 MB · a hit skips that provider&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=2;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;" vertex="1" parent="1"><mxGeometry x="616" y="640" width="680" height="120" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="q" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="MISS" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="d1" target="emb"><mxGeometry relative="1" x="0.0" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="emb" target="rr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="rr" target="ext"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="ext" target="syn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="syn" target="out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="LOOKUP" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=1.4;strokeColor=#5b616d;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="d1" target="c_ans"><mxGeometry relative="1" x="0.0" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="LOOKUP · STORE" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=block;startFill=1;startSize=6;strokeWidth=1.4;strokeColor=#5b616d;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="emb" target="c_emb"><mxGeometry relative="1" x="0.0" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="LOOKUP · STORE" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=block;startFill=1;startSize=6;strokeWidth=1.4;strokeColor=#5b616d;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="rr" targ