<mxfile host="ResearchX diagrams/src/build.py" type="device"><diagram id="05-laya-shadow-mode" name="Laya: advisory decisions, orchestrator authority"><mxGraphModel dx="1360" dy="720" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="720" background="#f6f5f1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#f6f5f1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1360" height="720" as="geometry"/></mxCell><mxCell id="t1" value="Laya: advisory decisions, orchestrator authority" style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=26;fontColor=#16181d;align=left;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1280" height="36" as="geometry"/></mxCell><mxCell id="t2" value="Laya answers beside every run and is traced; the deterministic rules decide. Shadow mode is the default." style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=14;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1280" height="22" as="geometry"/></mxCell><mxCell id="z3" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;fillColor=#efede6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="112" width="632" height="544" as="geometry"/></mxCell><mxCell id="t4" value="&lt;span style=&quot;letter-spacing:0.08em&quot;&gt;RESEARCH ORCHESTRATOR · AUTHORITATIVE&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="46" y="122" width="604" height="17" as="geometry"/></mxCell><mxCell id="z5" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;fillColor=#f8f1e4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="776" y="112" width="552" height="544" as="geometry"/></mxCell><mxCell id="t6" value="&lt;span style=&quot;letter-spacing:0.08em&quot;&gt;LAYA · laya-serve :8090 · OWN PROCESS&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="790" y="122" width="524" height="17" as="geometry"/></mxCell><mxCell id="q" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Question arrives&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;The run starts; Laya is asked in parallel&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="72" y="176" width="256" height="80" as="geometry"/></mxCell><mxCell id="rules" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;DETERMINISTIC&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Rules decide&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Intent, requested fields and the injection check set strategy and routing&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#e2f0ee;strokeColor=#0e6b66;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="72" y="288" width="256" height="104" as="geometry"/></mxCell><mxCell id="strat" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Strategy and routing&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;The rules&#x27; choice is applied&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="72" y="424" width="256" height="88" as="geometry"/></mxCell><mxCell id="run" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Retrieval, evidence, answer&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Unchanged by Laya in shadow mode&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="72" y="544" width="256" height="88" as="geometry"/></mxCell><mxCell id="trace" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;RESEARCH TRACE&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;laya_decision row&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Laya&#x27;s decision beside the rules&#x27; choice, with agreement, latency, mode and an authority note&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="384" y="288" width="256" height="136" as="geometry"/></mxCell><mxCell id="laya" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;~421M-PARAMETER CHECKPOINT&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Typed decision&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;workflow · external_needed · injection · depth · confidence&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#fbf0dc;strokeColor=#8f5405;strokeWidth=1.25;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="816" y="164" width="264" height="104" as="geometry"/></mxCell><mxCell id="shadow" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;DEFAULT · ENABLED&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Shadow mode&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Traced beside the rules&#x27; choice; never applied&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#fbf0dc;strokeColor=#8f5405;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="816" y="336" width="232" height="128" as="geometry"/></mxCell><mxCell id="advise" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;OFF BY DEFAULT&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Advise mode&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;May pick the larger synthesis model only at confidence 0.8+ when the rules found no intent; waits at most 1.5 s&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#8a8f99;strokeWidth=1.25;dashed=1;dashPattern=2 3;" vertex="1" parent="1"><mxGeometry x="1072" y="336" width="232" height="128" as="geometry"/></mxCell><mxCell id="fail" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;A failure costs only its trace row&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;4 s timeout per decision · slow or unreachable: traced as failed and the run carries on · below 0.8 confidence: traced as abstained · RESEARCHX_LAYA=0 turns it off&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#eef1f6;strokeColor=#9aa6b8;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="816" y="496" width="488" height="104" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="q" target="rules"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="APPLIED" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#efede6;" edge="1" parent="1" source="rules" target="strat"><mxGeometry relative="1" x="0.0" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="strat" target="run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.38235294117647056;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=1.4;strokeColor=#5b616d;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="rules" target="trace"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="QUESTION TEXT ONLY" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=1.4;strokeColor=#8f5405;dashed=1;dashPattern=6 4;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#8f5405;labelBackgroundColor=#efede6;" edge="1" parent="1" source="q" target="laya"><mxGeometry relative="1" x="-0.3115" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="TYPED DECISION" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0;exitY=0.7980769230769231;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=1.4;strokeColor=#8f5405;dashed=1;dashPattern=6 4;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#8f5405;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="laya" target="trace"><mxGeometry relative="1" x="0.0456" as="geometry"><Array as="points"><mxPoint x="720" y="247"/><mxPoint x="720" y="356"/></Array></mxGeometry></mxCell><mxCell id="e13" value="ADVISE MODE ONLY: SYNTHESIS HINT" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.6363636363636364;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=1.25;strokeColor=#8a8f99;dashed=1;dashPattern=6 4;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;labelBackgroundColor=#efede6;" edge="1" parent="1" source="advise" target="strat"><mxGeometry relative="1" x="0.5616" as="geometry"><Array as="points"><mxPoint x="1188" y="480"/></Array></mxGeometry></mxCell><mxCell id="t14" value="Laya never sees retrieved text or secrets, never decides what evidence exists and never blocks a request." style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=12.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="816" y="290" width="488" height="40" as="geometry"/></mxCell><mxCell id="l15" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#e2f0ee;strokeColor=#0e6b66;" vertex="1" parent="1"><mxGeometry x="40" y="681" width="22" height="16" as="geometry"/></mxCell><mxCell id="t16" value="Authoritative" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="681" width="97.7" height="18" as="geometry"/></mxCell><mxCell id="l17" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#fbf0dc;strokeColor=#8f5405;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="185.7" y="681" width="22" height="16" as="geometry"/></mxCell><mxCell id="t18" value="Advisory" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="215.7" y="681" width="63.2" height="18" as="geometry"/></mxCell><mxCell id="l19" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#fbf0dc;strokeColor=#8f5405;" vertex="1" parent="1"><mxGeometry x="296.9" y="681" width="22" height="16" as="geometry"/></mxCell><mxCell id="t20" value="Active mode" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="326.9" y="681" width="83.9" height="18" as="geometry"/></mxCell><mxCell id="l21" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#8a8f99;dashed=1;dashPattern=2 3;" vertex="1" parent="1"><mxGeometry x="428.79999999999995" y="681" width="22" height="16" as="geometry"/></mxCell><mxCell id="t22" value="Off by default" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="458.79999999999995" y="681" width="104.60000000000001" height="18" as="geometry"/></mxCell><mxCell id="l23" value="" style="line;strokeWidth=2;strokeColor=#0e6b66;" vertex="1" parent="1"><mxGeometry x="581.4" y="688" width="28" height="2" as="geometry"/></mxCell><mxCell id="t24" value="Applied" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="617.4" y="681" width="56.300000000000004" height="18" as="geometry"/></mxCell><mxCell id="l25" value="" style="line;strokeWidth=1.4;strokeColor=#8f5405;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="691.7" y="688" width="28" height="2" as="geometry"/></mxCell><mxCell id="t26" value="Advisory, traced" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="727.7" y="681" width="118.4" height="18" as="geometry"/></mxCell><mxCell id="l27" value="" style="line;strokeWidth=1.25;strokeColor=#8a8f99;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="864.1" y="688" width="28" height="2" as="geometry"/></mxCell><mxCell id="t28" value="Advise mode only" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="900.1" y="681" width="118.4" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>