;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="pgv" target="rrf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="704" y="256"/><mxPoint x="704" y="238"/></Array></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="rrf" target="rerank"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sel" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;UP TO 8 CORPUS + 4 EXTERNAL&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Evidence selection&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Passages graded 2+ first · recorded contradictions attached (rx.contradictions)&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="176" y="376" width="272" height="112" as="geometry"/></mxCell><mxCell id="suff" value="Evidence sufficient?" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12.5;fontColor=#16181d;fontStyle=1;fillColor=#ffffff;strokeColor=#16181d;strokeWidth=1.25;spacing=14;" vertex="1" parent="1"><mxGeometry x="1072" y="376" width="224" height="112" as="geometry"/></mxCell><mxCell id="t14" value="Sufficient: at least one passage graded 3 or two graded 2+, and the question&#x27;s rare terms appear in them." style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=13;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="520" y="372" width="480" height="44" as="geometry"/></mxCell><mxCell id="ext" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;ONLY ON A GAP · DEADLINE 9 S&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;External search&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Providers chosen by the missing evidence · per-user cache&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#8a8f99;strokeWidth=1.25;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="1040" y="512" width="272" height="104" as="geometry"/></mxCell><mxCell id="gate" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;SOURCE GATE&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Validate sources&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;HTTPS · no instruction-like text · not a duplicate · enough content&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="704" y="512" width="272" height="104" as="geometry"/></mxCell><mxCell id="xtr" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;NEMOTRON&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;External extraction&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Requested fields from abstracts; one arXiv full text if a value is still missing&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="368" y="512" width="272" height="104" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;