lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Field-level grounding&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;A value per requested field, with its verbatim span and conditions&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="448" y="688" width="272" height="104" as="geometry"/></mxCell><mxCell id="fv" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;DETERMINISTIC&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Fact validation&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Span in the source and holds the value; mismatched conditions stay UNKNOWN&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="784" y="688" width="256" height="104" as="geometry"/></mxCell><mxCell id="syn" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;NANO · SUPER FOR COMPARISONS&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Passage synthesis&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Claims, each with a verbatim quote and the number of its source&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="448" y="824" width="272" height="104" as="geometry"/></mxCell><mxCell id="cv" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;DETERMINISTIC&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Citation validation&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;The quote must appear in the cited source, with the claim&#x27;s numbers&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="784" y="824" width="256" height="104" as="geometry"/></mxCell><mxCell id="status" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Run status&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fill