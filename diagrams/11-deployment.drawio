<mxfile host="ResearchX diagrams/src/build.py" type="device"><diagram id="11-deployment" name="Deployment"><mxGraphModel dx="1360" dy="720" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="720" background="#f6f5f1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#f6f5f1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1360" height="720" as="geometry"/></mxCell><mxCell id="t1" value="Deployment" style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=26;fontColor=#16181d;align=left;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1280" height="36" as="geometry"/></mxCell><mxCell id="t2" value="One public web address: the web app on Vercel forwards /api/* to the API on Render, which reaches Supabase and the providers." style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=14;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1280" height="22" as="geometry"/></mxCell><mxCell id="z3" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;fillColor=#efede6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="112" width="264" height="384" as="geometry"/></mxCell><mxCell id="t4" value="&lt;span style=&quot;letter-spacing:0.08em&quot;&gt;BROWSER&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;align=left;verticalAlign=top;