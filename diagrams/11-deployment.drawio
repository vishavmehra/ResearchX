mxGeometry x="479.50000000000006" y="673" width="125.30000000000001" height="18" as="geometry"/></mxCell><mxCell id="l26" value="" style="line;strokeWidth=2;strokeColor=#0e6b66;" vertex="1" parent="1"><mxGeometry x="622.8000000000001" y="680" width="28" height="2" as="geometry"/></mxCell><mxCell id="t27" value="Request path" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="658.8000000000001" y="673" width="90.80000000000001" height="18" as="geometry"/></mxCell><mxCell id="l28" value="" style="line;strokeWidth=1.4;strokeColor=#5b616d;" vertex="1" parent="1"><mxGeometry x="767.6000000000001" y="680" width="28" height="2" as="geometry"/></mxCell><mxCell id="t29" value="Server-side call" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="803.6000000000001" y="673" width="118.4" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>