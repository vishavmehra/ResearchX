get="supa"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="912" y="424"/></Array></mxGeometry></mxCell><mxCell id="e16" value="SIGN IN WITH SUPABASE AUTH" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=1.4;strokeColor=#5b616d;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="user" target="supa"><mxGeometry relative="1" x="0.128" as="geometry"><Array as="points"><mxPoint x="164" y="528"/><mxPoint x="1196" y="528"/></Array></mxGeometry></mxCell><mxCell id="t17" value="Secrets live only in the hosts&#x27; environment settings: NEBIUS_API_KEY, the database connection, provider keys (TAVILY_API_KEY, CORE_API_KEY, OPENALEX_API_KEY). The browser receives only SUPABASE_URL and the publishable key; the Supabase redirect list must include the public URL. Nothing secret is in the repository." style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=12.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="568" width="1280" height="64" as="geometry"/></mxCell><mxCell id="l18" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#e2f0ee;strokeColor=#0e6b66;" vertex="1" parent="1"><mxGeometry x="40" y="673" width="22" height="16" as="geometry"/></mxCell><mxCell id="t19" value="Public entry" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=t