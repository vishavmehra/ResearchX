Cell><mxCell id="e16" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="z_full" target="z_ext"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="z_ext" target="z_rel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="z_rel" target="z_val"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="z_val" target="z_rls"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="z_rls" target="z_load"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="z_load" target="z_srv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t22" value="Licence and redistribution are recorded per paper; full texts stay local and are never committed." style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=12.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="822" y="236" width="212" height="112" as="geometry"/></mxCell><mxCell id="t23" value="The runtime serves the frozen release: its rows are loaded as they are, never edited in place." style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=12.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="550" y="672" width="212" height="112" as="geometry"/></mxCell><mxCell id="t24" value="Embeddings: Qwen3-Embedding-8B cut to 256 dimensions; the loader stops before the database passes 450 MB." style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=12.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="278" y="708" width="212" height="150" as="geometry"/></mxCell><mxCell id="t25" value="Stages run top to bottom within each group. Extraction combines deterministic rules with schema-bound Nemotron extraction, and every value keeps its evidence. The review loop (blue) is run by people, separately from the build." style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=12.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="892" width="1280" height="40" as="geometry"/></mxCell><mxCell id="l26" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#8a8f99;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="40" y="953" width="22" height="16" as="geometry"/></mxCell><mxCell id="t27" value="Public source" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="953" width="97.7" height="18" as="geometry"/></mxCell><mxCell id="l28" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#cfcabd;" vertex="1" parent="1"><mxGeometry x="185.7" y="953" width="22" height="16" as="geometry"/></mxCell><mxCell id="t29" value="Pipeline stage" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="215.7" y="953" width="104.60000000000001" height="18" as="geometry"/></mxCell><mxCell id="l30" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#eef1f6;strokeColor=#9aa6b8;" vertex="1" parent="1"><mxGeometry x="338.3" y="953" width="22" height="16" as="geometry"/></mxCell><mxCell id="t31" value="Human review loop" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="368.3" y="953" width="125.30000000000001" height="18" as="geometry"/></mxCell><mxCell id="l32" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#e2f0ee;strokeColor=#0e6b66;" vertex="1" parent="1"><mxGeometry x="511.6" y="953" width="22" height="16" as="geometry"/></mxCell><mxCell id="t33" value="Runtime" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="541.6" y="953" width="56.300000000000004" height="18" as="geometry"/></mxCell><mxCell id="l34" value="" style="line;strokeWidth=2;strokeColor=#0e6b66;" vertex="1" parent="1"><mxGeometry x="615.9000000000001" y="960" width="28" height="2" as="geometry"/></mxCell><mxCell id="t35" value="Data flow" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="651.9000000000001" y="953" width="70.1" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>