" value="NO" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=1.4;strokeColor=#5b616d;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;labelBackgroundColor=#efede6;" edge="1" parent="1" source="fits" target="last"><mxGeometry relative="1" x="0.0" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="NO" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=1.4;strokeColor=#5b616d;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;labelBackgroundColor=#efede6;" edge="1" parent="1" source="usable" target="last"><mxGeometry relative="1" x="-0.9098" as="geometry"><Array as="points"><mxPoint x="716" y="472"/><mxPoint x="716" y="844"/></Array></mxGeometry></mxCell><mxCell id="c17" value="TASK" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;fillColor=#efede6;strokeColor=#cfcabd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="768" y="152" width="132" height="32" as="geometry"/></mxCell><mxCell id="c18" value="FIRST CHOICE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;fillColor=#efede6;strokeColo