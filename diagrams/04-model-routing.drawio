=10;spacingRight=8;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12;fontColor=#5b616d;fillColor=#ffffff;fontStyle=0;strokeColor=#cfcabd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="376" width="140" height="64" as="geometry"/></mxCell><mxCell id="c36" value="fields stay UNKNOWN" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12;fontColor=#5b616d;fillColor=#ffffff;fontStyle=0;strokeColor=#cfcabd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1180" y="376" width="132" height="64" as="geometry"/></mxCell><mxCell id="c37" value="fallback answer" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12;fontColor=#16181d;fillColor=#ffffff;fontStyle=1;strokeColor=#cfcabd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="768" y="440" width="132" height="64" as="geometry"/></mxCell><mxCell id="c38" value="Nano" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12;fontColor=#5b616d;fillColor=#ffffff;fontStyle=0;strokeColor=#cfcabd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="900" y="440" width="140" height="64" as="geometry"/></mxCell><mxCell id="c39" value="none" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12;fontColor=#5b616d;fillColor=#ffffff;fontStyle=0;strokeColor=#cfcabd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="440" width="140" height="64" as="geometry"/></mxCell><mxCell id="c40" value="failure message, no answer" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12;fontColor=#5b616d;fillColor=#ffffff;fontStyle=0;strokeColor=#cfcabd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1180" y="440" width="132" height="64" as="geometry"/></mxCell><mxCell id="c41" value="embedding" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12;fontColor=#16181d;fillColor=#ffffff;fontStyle=1;strokeColor=#cfcabd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="768" y="504" width="132" height="64" as="geometry"/></mxCell><mxCell id="c42" value="Qwen3-Embedding-8B" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12;fontColor=#5b616d;fillColor=#ffffff;fontStyle=0;strokeColor=#cfcabd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="900" y="504" width="140" height="64" as="geometry"/></mxCell><mxCell id="c43" value="separate route, never used for generation" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12;fontColor=#5b616d;fillColor=#ffffff;fontStyle=0;strokeColor=#cfcabd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="504" width="140" height="64" as="geometry"/></mxCell><mxCell id="c44" value="BM25 alone (traced)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12;fontColor=#5b616d;fillColor=#ffffff;fontStyle=0;strokeColor=#cfcabd;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1180" y="504" width="132" height="64" as="geometry"/></mxCell><mxCell id="t46" value="•&amp;nbsp; Nothing a user sends can name a model or a route: the context rejects unknown fields.&lt;br&gt;&lt;br&gt;•&amp;nbsp; A route is skipped when it is not configured, has no key, failed repeatedly in the last minutes (circuit open), or its provider is not approved for private documents the context holds.&lt;br&gt;&lt;br&gt;•&amp;nbsp; Ultra is configured but never selected: its benefit has not been measured. A long prompt alone never escalates.&lt;br&gt;&lt;br&gt;•&amp;nbsp; Fallback budgets: reranking 8 s · synthesis 20 s · extraction 12 s · full-text extraction 30 s.&lt;br&gt;&lt;br&gt;•&amp;nbsp; Laya reaches the policy only in advise mode (off by default), as the synthesis complexity hint." style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=12.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="768" y="592" width="544" height="280" as="geometry"/></mxCell><mxCell id="l47" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#cfcabd;" vertex="1" parent="1"><mxGeometry x="40" y="921" width="22" height="16" as="geometry"/></