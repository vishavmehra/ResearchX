tps%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=12.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="784" width="1280" height="40" as="geometry"/></mxCell><mxCell id="l29" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#cfcabd;" vertex="1" parent="1"><mxGeometry x="40" y="849" width="22" height="16" as="geometry"/></mxCell><mxCell id="t30" value="Table" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="849" width="42.5" height="18" as="geometry"/></mxCell><mxCell id="l31" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#e2f0ee;strokeColor=#0e6b66;" vertex="1" parent="1"><mxGeometry x="130.5" y="849" width="22" height="16" as="geometry"/></mxCell><mxCell id="t32" value="One row per research run" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="160.5" y="849" width="173.60000000000002" height="18" as="geometry"/></mxCell><mxCell id="l33" value="" style="line;strokeWidth=1.4;strokeColor=#5b616d;" vertex="1" parent="1"><mxGeometry x="352.1" y="856" width="28" height="2" as="geometry"/></mxCell><mxCell id="t34" value="Parent to child rows" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;