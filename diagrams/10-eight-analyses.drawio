<mxfile host="ResearchX diagrams/src/build.py" type="device"><diagram id="10-eight-analyses" name="The eight research analyses"><mxGraphModel dx="1360" dy="1472" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1472" background="#f6f5f1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#f6f5f1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1360" height="1472" as="geometry"/></mxCell><mxCell id="t1" value="The eight research analyses" style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=26;fontColor=#16181d;align=left;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1280" height="36" as="geometry"/></mxCell><mxCell id="t2" value="One API, one shared foundation of validated records; papers outside the corpus are read at request time, never written." style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=14;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1280" height="22" as="geometry"/></mxCell><mxCell id="in1" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;WEB APP&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Analyze tab&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Pick experiments, papers or a benchmark; type a claim or a draft review&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="56" y="128" width="392" height="96" as="geometry"/></mxCell><mxCell id="in2" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;RESEARCH CHAT&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Papers and Benchmark modes&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Paper-to-Paper Diff and Benchmark Reality Explorer from plain text&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="480" y="128" width="392" height="96" as="geometry"/></mxCell><mxCell id="in3" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;KNOWLEDGE MAP · ANSWERS&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Links on sources and nodes&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Open an analysis on a cited paper, experiment or benchmark&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="904" y="128" width="400" height="96" as="geometry"/></mxCell><mxCell id="api" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;FASTAPI · /api/analysis/*&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Analysis API&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Each call is a traced research run of the caller (owner-only RLS); the run keeps a compact summary, not the evidence payload&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#e2f0ee;strokeColor=#0e6b66;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="56" y="264" width="1248" height="80" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15705128205128205;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="in1" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4967948717948718;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="in2" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8397435897435898;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="in3" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="grid" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;fillColor=#efede6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="384" width="1296" height="416" as="geometry"/></mxCell><mxCell id="t6" value="&lt;span style=&quot;letter-spacing:0.08em&quot;&gt;THE EIGHT ANALYSES&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="46" y="394" width="1268" height="17" as="geometry"/></mxCell><mxCell id="a0" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;GET /paper-diff · POST /papers/ask&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Paper-to-Paper Diff&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Two to four papers field by field, training settings stage by stage, with a fairness verdict; also from chat text&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="56" y="416" width="296" height="168" as="geometry"/></mxCell><mxCell id="b7" value="+ RUNTIME PAPERS ON REQUEST" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10;fontStyle=1;fontColor=#0e6b66;fillColor=#e2f0ee;strokeColor=#0e6b66;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="68" y="554" width="181" height="18" as="geometry"/></mxCell><mxCell id="a1" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;GET /discrepancy&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Result Discrepancy Investigator&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Why two similar experiments report different results: the score gap, verified differences and what is not stated&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="376" y="416" width="296" height="168" as="geometry"/></mxCell><mxCell id="a2" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;GET /recipe&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Reproducibility Recipe Builder&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;One experiment&#x27;s configuration as a validated reproduction spec; unstated settings stay UNKNOWN, never defaulted&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="696" y="416" width="296" height="168" as="geometry"/></mxCell><mxCell id="a3" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;GET /plan&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Next Experiment Planner&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Reproduce, ablate or transfer: the experiment that would most reduce uncertainty, derived from the records&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="1016" y="416" width="296" height="168" as="geometry"/></mxCell><mxCell id="a4" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;POST /claim&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Claim-to-Evidence Auditor&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;A stated comparison, reported value or training setting tested against the corpus records&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="56" y="608" width="296" height="168" as="geometry"/></mxCell><mxCell id="a5" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;GET /transfer&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Generalization and Transferability Analyzer&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Where else a model was evaluated, with the pre-training data and adaptation behind each result&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="376" y="608" width="296" height="168" as="geometry"/></mxCell><mxCell id="a6" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;POST /review&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Literature Review Completeness Auditor&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;What a question or draft review covers, and the benchmarks and model families the corpus suggests it leaves out&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="696" y="608" width="296" height="168" as="geometry"/></mxCell><mxCell id="a7" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;GET /benchmarks · GET /benchmark&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Benchmark Reality Explorer&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Every reported result for a benchmark and metric: COMPARABLE, CONDITIONALLY_COMPARABLE, INCOMPATIBLE or UNKNOWN; only comparable results are ranked&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="1016" y="608" width="296" height="168" as="geometry"/></mxCell><mxCell id="b8" value="+ RUNTIME PAPERS ON REQUEST" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10;fontStyle=1;fontColor=#0e6b66;fillColor=#e2f0ee;strokeColor=#0e6b66;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1028" y="746" width="181" height="18" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="api" target="grid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="found" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;fillColor=#efede6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="840" width="1296" height="256" as="geometry"/></mxCell><mxCell id="t10" value="&lt;span style=&quot;letter-spacing:0.08em&quot;&gt;SHARED FOUNDATION · services/analysis · services/comparison&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="46" y="850" width="1268" height="17" as="geometry"/></mxCell><mxCell id="f0" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;SCHEMA rx&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Validated experiment records&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Papers, experiments and evidence of the reviewed corpus release&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="56" y="872" width="400" height="96" as="geometry"/></mxCell><mxCell id="f1" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;services/analysis/facts.py&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Field facts&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;REPORTED · DERIVED · CONFLICTING · UNKNOWN, each with its evidence&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="480" y="872" width="400" height="96" as="geometry"/></mxCell><mxCell id="f2" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;services/analysis/configs.py&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Configuration identity&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Pre-training, fine-tuning and evaluation kept apart; links DERIVED with their rule&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="904" y="872" width="400" height="96" as="geometry"/></mxCell><mxCell id="f3" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;SILVER-LABELER-0.2.0&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Comparison engine&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Field by field after normalisation (val = validation set); UNKNOWN is never a match&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="56" y="984" width="400" height="96" as="geometry"/></mxCell><mxCell id="f4" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;services/analysis/enrich.py&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Request-time full-text reading&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Before a setting shows as not stated, passages that name it are read; checked values become DERIVED&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="480" y="984" width="400" height="96" as="geometry"/></mxCell><mxCell id="f5" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;RunTracer&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Research Trace&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Every call is a traced run: analysis_request, field_facts, comparison, coverage …&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="904" y="984" width="400" height="96" as="geometry"/></mxCell><mxCell id="e11" value="ALL EIGHT READ" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="grid" target="found"><mxGeometry relative="1" x="0.0" as="geometry"></mxGeometry></mxCell><mxCell id="z12" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;fillColor=#efede6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="1136" width="1296" height="272" as="geometry"/></mxCell><mxCell id="t13" value="&lt;span style=&quot;letter-spacing:0.08em&quot;&gt;RUNTIME PAPERS · READ AT REQUEST TIME FOR PAPER-TO-PAPER DIFF AND BENCHMARK REALITY EXPLORER · NOTHING IS WRITTEN TO THE CORPUS&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="46" y="1146" width="1268" height="17" as="geometry"/></mxCell><mxCell id="r1" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;WHAT THE USER TYPED&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Reference or topic&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Title, DOI, arXiv id or URL, Semantic Scholar or ACL Anthology URL&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="56" y="1168" width="188" height="152" as="geometry"/></mxCell><mxCell id="r2" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;IDENTIFIERS FIRST&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Resolve&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Corpus first by DOI, arXiv id or exact title; if opted in, Semantic Scholar, OpenAlex, arXiv&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="264" y="1168" width="188" height="152" as="geometry"/></mxCell><mxCell id="r3" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;runtime/reader.py&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Read&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;arXiv full text with its licence recorded, else the abstract alone&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="472" y="1168" width="188" height="152" as="geometry"/></mxCell><mxCell id="r4" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;fulltext_extraction&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Extract&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Schema-bound settings, evaluation conditions and result rows&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="680" y="1168" width="188" height="152" as="geometry"/></mxCell><mxCell id="r5" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;DETERMINISTIC&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Check&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Span holds the value · metric and dataset named · no instruction-like text&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="888" y="1168" width="188" height="152" as="geometry"/></mxCell><mxCell id="r6" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;PER USER · IN PROCESS&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Runtime records&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Configuration-level ids, stage kept; served through an Overlay beside corpus records&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#e2f0ee;strokeColor=#0e6b66;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1096" y="1168" width="188" height="152" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=2;strokeColor=#0e6b66;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#0e6b66;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="r5" target="r6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="OVERLAY" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8935185185185185;entryY=1;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=1.4;strokeColor=#5b616d;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;labelBackgroundColor=#f6f5f1;" edge="1" parent="1" source="r6" target="found"><mxGeometry relative="1" x="0.4444" as="geometry"></mxGeometry></mxCell><mxCell id="t20" value="A typed title resolves only on a close title match with no equal rival, otherwise the candidates are returned to pick from; a work already in the corpus is that corpus paper. Corpus papers without experiment records are read the same way when opted in. Only what the user typed reaches a provider; private documents are never read here." style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=12.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="56" y="1336" width="1248" height="56" as="geometry"/></mxCell><mxCell id="l21" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#ffffff;strokeColor=#cfcabd;" vertex="1" parent="1"><mxGeometry x="40" y="1433" width="22" height="16" as="geometry"/></mxCell><mxCell id="t22" value="Component" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="1433" width="70.1" height="18" as="geometry"/></mxCell><mxCell id="l23" value="" style="rounded=1;arcSize=3;absoluteArcSize=1;fillColor=#e2f0ee;strokeColor=#0e6b66;" vertex="1" parent="1"><mxGeometry x="158.1" y="1433" width="22" height="16" as="geometry"/></mxCell><mxCell id="t24" value="Entry or result" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=11.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="188.1" y="1433" width="111.5" height="18" as="geometry"/></mxCell><mxCell id="l25" value="" style="line;strokeWidth=2;strokeColor=#0e6b66;" vertex="1" parent="1"><mxGeometry x="317.6" y="1440" width="28" height="2" as="geometry"/></mxCell><mxCell id="t26" value="Request flow" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSi