# ResearchX environment variables (template). Copy to `.env` for local development and fill in your own values.
# `.env` is git-ignored. Never commit real credentials, never put them in datasets, docs, logs, Docker images or
# client-side code. Production uses the deployment platform's secret store (for example Vercel Environment
# Variables). Backend services read secrets; they are never sent to the browser or returned by the API.
# If a credential is exposed anywhere (chat, logs, commits), revoke or rotate it immediately.

# --- Model inference (required for live LLM extraction; cached calls replay without it) -----------------------
NEBIUS_API_KEY=                # Nebius Token Factory (OpenAI-compatible); config/models.yaml

# --- External research at runtime (not used by the dataset pipeline) -------------------------------------------
TAVILY_API_KEY=                # Tavily search / extract (WebResearchProvider); credit-limited plan

# --- Scholarly sources (dataset pipeline) ------------------------------------------------------------------------
S2_API_KEY=                    # Semantic Scholar Graph / Datasets API (higher rate limits)
OPENALEX_API_KEY=              # OpenAlex usage allowance (optional)
RESEARCHX_CONTACT_EMAIL=       # OpenAlex polite-pool mailto (optional)
UNPAYWALL_EMAIL=               # Unpaywall requires a real contact email per request
OPENREVIEW_USERNAME=           # OpenReview API v2 login (read-only use)
OPENREVIEW_PASSWORD=
CORE_API_KEY=                  # CORE API (full text needs per-work licence checks)
HF_TOKEN=                      # Hugging Face (gated evaluation datasets such as GAIA; evaluation-only)

# --- Runtime API (services/api) -----------------------------------------------------------------------------------
DATABASE_URL=                  # Supabase PostgreSQL (server only): public corpus, traces, account deletion; RLS for users
RESEARCHX_CORS_ORIGINS=        # comma-separated browser origins allowed to call the API directly (default http://localhost:3000)
RESEARCHX_RATE_PER_MIN=        # research runs per user per minute (default 12)
VECTOR_DB_URL=                 # only if a separate vector store is introduced (pgvector lives in PostgreSQL)

# --- Web app (apps/web/.env.local, or the web project's environment in production) ------------------------------
# NEXT_PUBLIC_SUPABASE_URL=              same value as SUPABASE_URL (public)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  same value as SUPABASE_PUBLISHABLE_KEY (public; RLS protects the data)
# RESEARCHX_API_ORIGIN=                  where the Next.js rewrite sends /api/* (e.g. http://127.0.0.1:8000)
# Nothing else belongs in the web app's environment: no DATABASE_URL, no provider keys.

# --- Supabase (managed PostgreSQL + pgvector) --------------------------------------------------------------------
SUPABASE_URL=                  # project URL (not secret)
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=      # client-safe key; still not committed
SUPABASE_SERVICE_ROLE_KEY=     # not used by ResearchX (it bypasses RLS); leave empty unless a server task needs it
SUPABASE_DB_PASSWORD=          # database password; DATABASE_URL is built from it
