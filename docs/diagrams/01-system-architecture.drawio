d;margin-top:4px;line-height:1.38;&quot;&gt;Traced beside each run&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#fbf0dc;strokeColor=#8f5405;strokeWidth=1.25;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="152" y="464" width="208" height="128" as="geometry"/></mxCell><mxCell id="b13" value="&lt;div style=&quot;font-weight:600&quot;&gt;SHADOW MODE&lt;/div&gt;&lt;div style=&quot;font-weight:400&quot;&gt;advisory only, never applied&lt;/div&gt;" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10;fontStyle=0;fontColor=#8f5405;fillColor=#fbf0dc;strokeColor=#8f5405;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="164" y="546" width="184" height="34" as="geometry"/></mxCell><mxCell id="orch" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;services/runtime&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Research orchestrator&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Deterministic pipeline: retrieve, rerank, ground, synthesise, validate citations, abstain&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#e2f0ee;strokeColor=#0e6b66;s