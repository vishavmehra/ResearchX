<mxfile host="ResearchX docs/diagrams/src/build.py" type="device"><diagram id="09-auth-private-library" name="Authentication, private library and isolation"><mxGraphModel dx="1360" dy="1120" grid="1" gridSize="4" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1120" background="#f6f5f1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#f6f5f1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1360" height="1120" as="geometry"/></mxCell><mxCell id="t1" value="Authentication, private library and isolation" style="text;html=1;whiteSpace=wrap;fontFamily=Source Serif 4;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DSource%2BSerif%2B4%3Aital%2Cwght%400%2C600%3B1%2C400%26display%3Dswap;fontSize=26;fontColor=#16181d;align=left;verticalAlign=top;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="1280" height="36" as="geometry"/></mxCell><mxCell id="t2" value="Identity comes only from a token Supabase Auth has verified; PostgreSQL row-level security enforces ownership." style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fontSize=14;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1280" height="22" as="geometry"/></mxCell><mxCell id="z3" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;fillColor=#efede6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="112" width="312" height="720" as="geometry"/></mxCell><mxCell id="t4" value="&lt;span style=&quot;letter-spacing:0.08em&quot;&gt;BROWSER&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="46" y="122" width="284" height="17" as="geometry"/></mxCell><mxCell id="z5" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;fillColor=#efede6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="376" y="112" width="400" height="720" as="geometry"/></mxCell><mxCell id="t6" value="&lt;span style=&quot;letter-spacing:0.08em&quot;&gt;API · services/api&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="122" width="372" height="17" as="geometry"/></mxCell><mxCell id="z7" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;fillColor=#efede6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="808" y="112" width="520" height="720" as="geometry"/></mxCell><mxCell id="t8" value="&lt;span style=&quot;letter-spacing:0.08em&quot;&gt;SUPABASE&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="822" y="122" width="492" height="17" as="geometry"/></mxCell><mxCell id="z9" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;fillColor=#efede6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="864" width="1296" height="136" as="geometry"/></mxCell><mxCell id="t10" value="&lt;span style=&quot;letter-spacing:0.08em&quot;&gt;MODEL AND EVIDENCE PROVIDERS&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;align=left;verticalAlign=top;spacing=0;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="46" y="874" width="1268" height="17" as="geometry"/></mxCell><mxCell id="b_web" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;SUPABASE CLIENT&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Web app&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Signs in with the publishable key only; no secret reaches the browser&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="56" y="152" width="264" height="104" as="geometry"/></mxCell><mxCell id="b_req" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Research and library calls&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Authorization: Bearer &amp;lt;access token&amp;gt; on every request&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="56" y="296" width="264" height="104" as="geometry"/></mxCell><mxCell id="b_up" value="&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:0px;line-height:1.25;&quot;&gt;Upload a document&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;PDF or text, sent to the API&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="56" y="576" width="264" height="96" as="geometry"/></mxCell><mxCell id="a_ver" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;services/auth/supabase.py&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Verify the access token&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Asks Supabase Auth (GET /auth/v1/user), accepted for at most 30 s · MFA users need an aal2 session · request bodies reject unknown fields, so a forged user_id is refused&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#e2f0ee;strokeColor=#0e6b66;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="352" height="136" as="geometry"/></mxCell><mxCell id="a_utx" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;user_tx()&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Queries as the user&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Role authenticated with exactly the verified claims; no service-role key in the API&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="400" y="448" width="352" height="96" as="geometry"/></mxCell><mxCell id="a_doc" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;POST /api/documents&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Document pipeline&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;File to the user&#x27;s folder · chunks and embeddings · the user&#x27;s answer cache is emptied&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="400" y="576" width="352" height="104" as="geometry"/></mxCell><mxCell id="a_run" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;PRIVACY SCOPE USER-PRIVATE&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Private retrieval in a run&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;The user&#x27;s chunks, searched under RLS&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="400" y="712" width="352" height="96" as="geometry"/></mxCell><mxCell id="s_auth" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;SUPABASE AUTH&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Accounts and sessions&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;E-mail and password · Google · GitHub · TOTP MFA&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;" vertex="1" parent="1"><mxGeometry x="832" y="152" width="472" height="104" as="geometry"/></mxCell><mxCell id="s_pg" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;POSTGRES · ROW-LEVEL SECURITY&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Owner-only rows&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Documents, chunks, research runs, trace events, caches, conversations · the shared corpus is read through the backend&#x27;s service connection&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=2;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;" vertex="1" parent="1"><mxGeometry x="832" y="440" width="472" height="160" as="geometry"/></mxCell><mxCell id="s_sto" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;STORAGE · BUCKET user-documents&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;One folder per user&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;&amp;lt;user id&amp;gt;/&amp;lt;document&amp;gt; · storage policies keep each user in their own folder&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=2;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#cfcabd;strokeWidth=1.25;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;" vertex="1" parent="1"><mxGeometry x="832" y="632" width="472" height="112" as="geometry"/></mxCell><mxCell id="p_neb" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;NEBIUS TOKEN FACTORY · NVIDIA&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Approved for private data&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;May receive private passages for synthesis and extraction&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#8a8f99;strokeWidth=1.25;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="400" y="888" width="352" height="88" as="geometry"/></mxCell><mxCell id="p_ext" value="&lt;div style=&quot;font-family:IBM Plex Mono;font-size:10.5px;letter-spacing:0.04em;color:#8a8f99;line-height:1.3;&quot;&gt;SCHOLARLY + WEB&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#16181d;margin-top:3px;line-height:1.25;&quot;&gt;Evidence providers&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#5b616d;margin-top:4px;line-height:1.38;&quot;&gt;Receive search terms from the question only; never private text&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BSans%3Awght%40400%3B600%26display%3Dswap;fillColor=#ffffff;strokeColor=#8a8f99;strokeWidth=1.25;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="832" y="888" width="472" height="88" as="geometry"/></mxCell><mxCell id="e11" value="SIGN IN · SESSION" style="edgeStyle=none;rounded=1;arcSize=12;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeWidth=1.4;strokeColor=#5b616d;fontFamily=IBM Plex Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DIBM%2BPlex%2BMono%3Awght%40400%3B600%26display%3Dswap;fontSize=10.5;fontColor=#5b616d;labelBackgroundColor=#efede6;" edge="1" parent="1" source="b_web" target="s_auth"><mxGeometry relative="1" x="0.0" as="geomet