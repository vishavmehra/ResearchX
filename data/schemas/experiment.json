          "type": "object"
        },
        "human_reviewed_fields": {
          "default": 0,
          "minimum": 0,
          "title": "Human Reviewed Fields",
          "type": "integer"
        },
        "paper_text_fields": {
          "minimum": 0,
          "title": "Paper Text Fields",
          "type": "integer"
        },
        "technical_fields_known": {
          "minimum": 0,
          "title": "Technical Fields Known",
          "type": "integer"
        },
        "tier": {
          "$ref": "#/$defs/DepthTier"
        }
      },
      "required": [
        "tier",
        "dimensions",
        "technical_fields_known",
        "paper_text_fields",
        "artifact_fields",
        "depth_version"
      ],
      "title": "DepthAssessment",
      "type": "object"
    },
    "DepthTier": {
      "enum": [
        "metadata_only",
        "shallow_result",
        "partial_configuration",
        "deep_configuration",
