  "$id": "researchx://schemas/0.2.0/experiment.json",
  "additionalProperties": false,
  "description": "One experimental condition (spec \u00a72, \u00a710). Outcomes hold per-metric observations.",
  "properties": {
    "artifacts": {
      "$ref": "#/$defs/Artifacts"
    },
    "compute": {
      "$ref": "#/$defs/ComputeConfiguration"
    },
    "confidence": {
      "anyOf": [
        {
