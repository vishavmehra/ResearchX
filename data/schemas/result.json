        "type": "string"
      },
      "title": "Row Header Path",
      "type": "array"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "source_kind": {
      "$ref": "#/$defs/ResultSourceKind"
    },
    "source_location": {
      "title": "Source Location",
      "type": "string"
    },
    "source_record_id": {
      "title": "Source Record Id",
      "type": "string"
    },
