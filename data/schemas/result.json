  "required": [
    "provenance",
    "result_id",
    "paper_id",
    "study_id",
    "source_kind",
    "source_record_id",
    "raw_value",
    "source_location",
    "extraction_version"
  ],
  "title": "ResultRecord",
  "type": "object",
  "x-schema-version": "0.2.0"
}
