{
  "$defs": {
    "EvidenceClass": {
      "enum": [
        "SUFFICIENT_EVIDENCE",
        "INSUFFICIENT_EVIDENCE",
        "CONFLICTING_EVIDENCE"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "ExpectedBehavior": {
      "enum": [
        "ANSWER",
        "ABSTAIN",
        "ESCALATE",
        "SEARCH_MORE",
        "ASK_USER"
      ],
      "title": "ExpectedBehavior",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Spec \u00a730 minimum provenance fields.",
      "properties": {
        "annotator_status": {
          "$ref": "#/$defs/ReviewerStatus",
          "default": "UNREVIEWED"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "extractor_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extractor Version"
        },
        "parent_record_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parent Record Ids",
          "type": "array"
        },
        "processing_version": {
          "title": "Processing Version",
          "type": "string"
        },
        "raw_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Path"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "source_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Identifier"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source_name",
        "processing_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QualityTier": {
      "enum": [
        "GOLD",
        "SILVER",
        "BRONZE"
      ],
      "title": "QualityTier",
      "type": "string"
    },
    "ReviewerStatus": {
      "enum": [
        "UNREVIEWED",
        "IN_REVIEW",
        "REVIEWED",
        "ADJUDICATED",
        "DISPUTED"
      ],
      "title": "ReviewerStatus",
      "type": "string"
    },
    "Split": {
      "enum": [
        "TRAIN",
        "VALIDATION",
        "TEST",
        "GOLD_EVAL",
        "SAFETY_EVAL",
        "REGRESSION",
        "TEMPORAL_TEST",
        "CROSS_SPLIT",
        "UNASSIGNED"
      ],
      "title": "Split",
      "type": "string"
    }
  },
  "$id": "researchx://schemas/0.2.0/abstention.json",
  "additionalProperties": false,
  "description": "Spec \u00a719.",
  "properties": {
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "conflicting_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Conflicting Fields",
      "type": "array"
    },
    "context_ids": {
      "items": {
        "type": "string"
      },
      "title": "Context Ids",
      "type": "array"
    },
    "evidence_class": {
      "$ref": "#/$defs/EvidenceClass"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "expected_behavior": {
      "$ref": "#/$defs/ExpectedBehavior"
    },
    "missing_information": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "quality_tier": {
      "$ref": "#/$defs/QualityTier",
      "default": "SILVER"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "question_template": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question Template"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "record_type": {
      "const": "abstention",
      "default": "abstention",
      "title": "Record Type",
      "type": "string"
    },
    "reviewer_status": {
      "$ref": "#/$defs/ReviewerStatus",
      "default": "UNREVIEWED"
    },
    "split": {
      "$ref": "#/$defs/Split",
      "default": "UNASSIGNED"
    },
    "synthetic_question": {
      "default": false,
      "title": "Synthetic Question",
      "type": "boolean"
    }
  },
  "required": [
    "provenance",
    "case_id",
    "question",
    "context_ids",
    "evidence_class",
    "expected_behavior",
    "rationale"
  ],
  "title": "AbstentionCase",
  "type": "object",
  "x-schema-version": "0.2.0"
}
