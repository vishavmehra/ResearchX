{
  "$defs": {
    "Author": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "orcid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orcid"
        },
        "raw_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Name"
        },
        "source_author_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Author Id"
        }
      },
      "required": [
        "name"
      ],
      "title": "Author",
      "type": "object"
    },
    "FulltextFormat": {
      "enum": [
        "PDF",
        "HTML",
        "XML",
        "TEI_XML",
        "STRUCTURED_TEXT"
      ],
      "title": "FulltextFormat",
      "type": "string"
    },
    "FulltextInfo": {
      "additionalProperties": false,
      "description": "Spec \u00a736 per-document full-text fields.",
      "properties": {
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/FulltextFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "full_text_available": {
          "title": "Full Text Available",
          "type": "boolean"
        },
        "full_text_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Full Text Source"
        },
        "license_status": {
          "default": "UNKNOWN",
          "enum": [
            "PERMITTED",
            "RESTRICTED",
            "UNKNOWN"
          ],
          "title": "License Status",
          "type": "string"
        },
        "parsed_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parsed Path"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "retrieval_timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Timestamp"
        },
        "retrieval_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Url"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "full_text_available"
      ],
      "title": "FulltextInfo",
      "type": "object"
    },
    "LicenseInfo": {
      "additionalProperties": false,
      "properties": {
        "content_license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content License"
        },
        "license_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Source"
        },
        "metadata_license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metadata License"
        },
        "redistribution_allowed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redistribution Allowed"
        },
        "training_allowed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Allowed"
        }
      },
      "title": "LicenseInfo",
      "type": "object"
    },
    "MergeEvidence": {
      "additionalProperties": false,
      "properties": {
        "matched_on": {
          "enum": [
            "arxiv_id",
            "doi",
            "self"
          ],
          "title": "Matched On",
          "type": "string"
        },
        "source_record_id": {
          "title": "Source Record Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "source_record_id",
        "matched_on",
        "value"
      ],
      "title": "MergeEvidence",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Spec \u00a730 minimum provenance fields.",
      "properties": {
        "annotator_status": {
          "$ref": "#/$defs/ReviewerStatus",
          "default": "UNREVIEWED"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "extractor_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extractor Version"
        },
        "parent_record_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parent Record Ids",
          "type": "array"
        },
        "processing_version": {
          "title": "Processing Version",
          "type": "string"
        },
        "raw_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Path"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "source_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Identifier"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version"
        }
      },
      "required": [
        "source_name",
        "processing_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QualityTier": {
      "enum": [
        "GOLD",
        "SILVER",
        "BRONZE"
      ],
      "title": "QualityTier",
      "type": "string"
    },
    "Relevance": {
      "additionalProperties": false,
      "properties": {
        "areas": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Areas",
          "type": "array"
        },
        "field_check": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Check"
        },
        "is_relevant": {
          "title": "Is Relevant",
          "type": "boolean"
        },
        "matched_terms": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "default": {},
          "title": "Matched Terms",
          "type": "object"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        }
      },
      "required": [
        "is_relevant",
        "rule_version"
      ],
      "title": "Relevance",
      "type": "object"
    },
    "ReviewerStatus": {
      "enum": [
        "UNREVIEWED",
        "IN_REVIEW",
        "REVIEWED",
        "ADJUDICATED",
        "DISPUTED"
      ],
      "title": "ReviewerStatus",
      "type": "string"
    },
    "Split": {
      "enum": [
        "TRAIN",
        "VALIDATION",
        "TEST",
        "GOLD_EVAL",
        "SAFETY_EVAL",
        "REGRESSION",
        "TEMPORAL_TEST",
        "CROSS_SPLIT",
        "UNASSIGNED"
      ],
      "title": "Split",
      "type": "string"
    }
  },
  "$id": "researchx://schemas/0.2.0/paper.json",
  "additionalProperties": false,
  "description": "Identifier-merged view of SourceRecords for one paper (spec \u00a74.2, \u00a729).",
  "properties": {
    "abstract": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstract"
    },
    "arxiv_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arxiv Id"
    },
    "authors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Author"
      },
      "title": "Authors",
      "type": "array"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "field_sources": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Field Sources",
      "type": "object"
    },
    "fulltext": {
      "anyOf": [
        {
          "$ref": "#/$defs/FulltextInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "identifiers": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Identifiers",
      "type": "object"
    },
    "license": {
      "$ref": "#/$defs/LicenseInfo",
      "default": {
        "content_license": null,
        "license_source": null,
        "metadata_license": null,
        "redistribution_allowed": null,
        "training_allowed": null
      }
    },
    "merge_evidence": {
      "items": {
        "$ref": "#/$defs/MergeEvidence"
      },
      "title": "Merge Evidence",
      "type": "array"
    },
    "metadata_conflicts": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Metadata Conflicts",
      "type": "array"
    },
    "normalized_title": {
      "title": "Normalized Title",
      "type": "string"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "publication_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Date"
    },
    "publication_year": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Year"
    },
    "quality_tier": {
      "$ref": "#/$defs/QualityTier",
      "default": "BRONZE"
    },
    "record_type": {
      "const": "paper",
      "default": "paper",
      "title": "Record Type",
      "type": "string"
    },
    "relevance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Relevance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Record Ids",
      "type": "array"
    },
    "split": {
      "$ref": "#/$defs/Split",
      "default": "UNASSIGNED"
    },
    "study_id": {
      "title": "Study Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "venue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Venue"
    }
  },
  "required": [
    "provenance",
    "paper_id",
    "study_id",
    "title",
    "normalized_title",
    "source_record_ids",
    "merge_evidence"
  ],
  "title": "Paper",
  "type": "object",
  "x-schema-version": "0.2.0"
}
